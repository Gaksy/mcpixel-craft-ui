{
  "name": "mcpixel-craft-ui",
  "version": "0.7.0",
  "description": "像素风（Minecraft 风格）Vue 3 组件库：按钮 / 输入框 / 多选框 / 开关 / 卡片 / 表格 / 分页",
  "keywords": ["vue3", "vue", "component-library", "pixel", "minecraft", "ui"],
  "homepage": "https://www.inception.work/mcpixel-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaksy/mcpixel-craft-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Gaksy/mcpixel-craft-ui/issues"
  },
  "main": "./dist/mcpixel-craft-ui.umd.js",
  "module": "./dist/mcpixel-craft-ui.es.js",
  "types": "./dist/types/index.d.ts",
  "style": "./dist/mcpixel-craft-ui.css",
  "files": ["dist"],

  "exports": {
    ".": {
      "import": "./dist/mcpixel-craft-ui.es.js",
      "require": "./dist/mcpixel-craft-ui.umd.js",
      "types": "./dist/types/index.d.ts"
    },
    "./style.css": "./dist/mcpixel-craft-ui.css"
  },

  "scripts": {
    "build": "vite build",
    "pack": "npm pack",
    "build:withpack": "npm run build && npm run pack",
    "prepare": "npm run build"
  },

  "peerDependencies": {
    "vue": "^3.5.32"
  },

  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.4"
  },

  "dependencies": {
    "fs-extra": "^11.3.4"
  }
}
